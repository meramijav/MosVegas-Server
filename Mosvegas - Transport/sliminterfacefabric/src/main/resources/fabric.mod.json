  "authors": ["Telegram: @merami19", "Merami Studio — Telegram: @merami_studio"],
  "contact": {"homepage": "https://t.me/merami_studio"},
  "license": "All Rights Reserved",
  "environment": "*",
  "entrypoints": {
    "main": ["studio.merami.sliminterfacefabric.SlimVehicle"],
    "client": ["studio.merami.sliminterfacefabric.client.SlimVehicleClient"],
    "dynamiclights": ["studio.merami.sliminterfacefabric.client.light.DynamicLightsCompat"]
  },
  "mixins": ["slimvehicle.mixins.json"],
  "depends": {
    "fabricloader": ">=0.15.11",
    "minecraft": "~1.20.4",
    "java": ">=17",
    "fabric-api": "*"
